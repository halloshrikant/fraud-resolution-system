# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ==================== Development Mode ====================
# Set to True for local development (disables auth, enables docs)
# Set to False for production (enforces auth, disables public docs)
DEV_MODE=True

# ==================== Redis Configuration ====================
# Local development
REDIS_HOST=localhost
REDIS_TLS_PORT=6379

# Production with TLS (uncomment and configure)
# REDIS_HOST=redis.production.example.com
# REDIS_TLS_PORT=6380
# REDIS_PASSWORD=your-redis-password
# REDIS_TLS_CERT=/path/to/client-cert.pem
# REDIS_TLS_KEY=/path/to/client-key.pem
# REDIS_CA_CERT=/path/to/ca-cert.pem

# ==================== AWS Configuration ====================
AWS_REGION=us-east-1

# AWS Credentials (for local development)
# In production (EKS), use IAM roles instead
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ==================== AWS Cognito (Authentication) ====================
# Get these from AWS Cognito Console
COGNITO_USER_POOL_ID=us-east-1_XXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== CORS Configuration ====================
# Allowed origins for cross-origin requests (JSON array format)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Production example:
# ALLOWED_ORIGINS=["https://portal.example.com","https://admin.example.com"]

# ==================== MLflow Tracking ====================
# Local development (SQLite)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Kubernetes deployment
# MLFLOW_TRACKING_URI=http://mlflow.fraud-system.svc.cluster.local:5000

# Remote MLflow server
# MLFLOW_TRACKING_URI=https://mlflow.example.com

# ==================== Optional: Advanced Settings ====================
# Uncomment to override defaults

# Rate limiting
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Database
# MAX_POOL_SIZE=10
